# Copy to backend/.env. Keep SUPABASE_SERVICE_ROLE_KEY exclusively here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_ORIGIN=http://localhost:3000
PORT=4000
COOKIE_SECURE=false
# Optional: set to the known number of trusted reverse-proxy hops only.
# TRUST_PROXY=1
SEED_SUPERADMIN_EMAIL=admin@smkn1jkt.sch.id
SEED_SUPERADMIN_PASSWORD=smkn1jkt
SEED_SUPERADMIN_NAME=Administrator Sistem
# Public school-profile chatbot. Keep the API key in the backend only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Fallback is attempted in this order. Replace IDs if OpenRouter changes availability.
OPENROUTER_MODEL_1=qwen/qwen3.8-27b:free
OPENROUTER_MODEL_2=google/gemma-4-31b-it:free
OPENROUTER_MODEL_3=nvidia/nemotron-3.5-lightning:free