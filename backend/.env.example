# Copy to backend/.env. Keep all keys server-side; never use a NEXT_PUBLIC_* variable.
CMS_SUPABASE_URL=
CMS_SUPABASE_ANON_KEY=
CMS_SUPABASE_SERVICE_ROLE_KEY=

# Exact browser origins allowed by the Express API (comma-separated if required).
FRONTEND_ORIGINS=http://localhost:3000
PORT=4000
# Set only when running behind a trusted proxy; value is the trusted hop count.
# TRUST_PROXY=1

# Optional OpenRouter-compatible school-profile chatbot. If unset, only chat returns 503.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_1=qwen/qwen3.8-27b:free
OPENROUTER_MODEL_2=google/gemma-4-31b-it:free
OPENROUTER_MODEL_3=nvidia/nemotron-3.5-lightning:free
