# Copy to backend/.env. Keep all keys server-side; never use a NEXT_PUBLIC_* variable.
CMS_SUPABASE_URL=
CMS_SUPABASE_ANON_KEY=
CMS_SUPABASE_SERVICE_ROLE_KEY=

# Exact browser origins allowed by the Express API (comma-separated if required).
FRONTEND_ORIGINS=http://localhost:3000
PORT=4000
# Set only when running behind a trusted proxy; value is the trusted hop count.
# TRUST_PROXY=1

# Optional Groq school-profile chatbot. If unset, only chat returns 503.
# GROQ_MODEL is the primary model; GROQ_MODEL_2/GROQ_MODEL_3 are optional fallbacks.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODEL_2=openai/gpt-oss-20b
GROQ_MODEL_3=openai/gpt-oss-120b
