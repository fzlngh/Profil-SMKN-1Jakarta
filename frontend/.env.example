NEXT_PUBLIC_SITE_NAME=SMK Negeri 1 Jakarta
NEXT_PUBLIC_SITE_TAGLINE=Belajar · Berkarya · Berdampak

# CMS API origin used by server-side page loaders and the same-origin chat proxy.
# This URL is not a credential. Never add AI provider keys to NEXT_PUBLIC variables.
# AI provider credentials belong only in the separate Express backend environment.
NEXT_PUBLIC_CMS_SUPABASE_URL=
NEXT_PUBLIC_CMS_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CMS_API_URL=http://localhost:4000
